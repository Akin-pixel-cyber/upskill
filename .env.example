# ============================================================
# Exquis Upskill - environment configuration
# Copy to .env (cp .env.example .env) and fill in. NEVER commit .env.
# ============================================================

# ---- Public address -----------------------------------------
# URL people type in the browser. Used in email links. No trailing slash.
# For now:  http://<EC2-PUBLIC-IP>:8080     Later:  https://upskill.yourdomain.com
APP_URL=http://CHANGE_ME_EC2_IP:8080
# Port exposed on the server while using the IP address.
APP_PORT=8080
# Leave as :8080 while using the IP. For HTTPS later set to your domain (see STEPS.md, Part 13).
SITE_ADDRESS=:8080

# ---- Access rules -------------------------------------------
# Only emails ending in this domain can sign up.
EMAIL_DOMAIN=exquisappfactory.com
# Comma-separated. These emails become Admin automatically when they sign up.
ADMIN_EMAILS=you@exquisappfactory.com

# ---- Database -----------------------------------------------
POSTGRES_USER=upskill
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=upskill

# ---- Security -----------------------------------------------
# Generate: openssl rand -hex 48   (at least 32 characters)
SESSION_SECRET=CHANGE_ME
# Leave empty: secure cookies switch on automatically when APP_URL starts with https://
COOKIE_SECURE=

# ---- Email (Zoho Mail SMTP) ---------------------------------
# Leave SMTP_HOST empty to print verification/reset links in the server logs instead.
# Host by Zoho data centre: smtp.zoho.com (US) | smtp.zoho.eu (EU) | smtp.zoho.in (India)
#   | smtp.zoho.com.au (AU) | smtp.zoho.jp (JP) | smtp.zohocloud.ca (CA) | smtppro.zoho.com (Zoho Workplace paid orgs)
# Port 465 = SSL, 587 = STARTTLS. Password must be a Zoho APP PASSWORD, not your login password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Exquis Upskill <upskill@exquisappfactory.com>"

# ---- AI plan generation (optional) --------------------------
# AI_PROVIDER: openai | anthropic. Leave AI_API_KEY empty to use the built-in template generator.
AI_PROVIDER=
AI_API_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-sonnet-4-5)
AI_MODEL=

# ---- Backups (used by scripts/backup.sh and restore.sh) -----
S3_BUCKET=your-company-upskill-backups
AWS_REGION=eu-west-1
